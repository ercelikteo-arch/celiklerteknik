# Database
DATABASE_URL="postgresql://username:password@localhost:5432/celiklerteknik?schema=public"

# Auth
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production-min-32-chars"
NEXTAUTH_SECRET="your-nextauth-secret-key"
NEXTAUTH_URL="http://localhost:3000"

# Site URL (for emails and redirects)
SITE_URL="https://celiklerteknik.com"

# Email (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
ADMIN_EMAIL="admin@celiklerteknik.com"

# File Upload
UPLOAD_DIR="public/uploads"
MAX_FILE_SIZE="5242880"

# Cloudinary (Production - optional)
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# Google Analytics 4
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Google Search Console Verification
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION="your-verification-code"

# Rate Limiting (optional - defaults in code)
# LOGIN_RATE_LIMIT="5"
# LOGIN_RATE_WINDOW="900000"
# API_RATE_LIMIT="100"
# API_RATE_WINDOW="60000"
